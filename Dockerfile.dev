# Contêiner de DESENVOLVIMENTO do viewer. NÃO produz bundle de produção.
#
# Roda o rspack dev server em watch, com HMR, contra o código montado do host.
# Ver docs/plano-stack-dev-e-rtpy.md, seção 3.
#
# Por que existe separado do Dockerfile: aquele faz `pnpm install` + `rspack
# build` e pede 4-6 GiB de pico. Este não builda nada em tempo de imagem --
# o install acontece no primeiro `up`, contra um volume nomeado.
FROM node:24.13.0-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    # O default do node em contêiner (~2 GiB) é apertado para o grafo do OHIF.
    # Fica ABAIXO do mem_limit do compose de propósito: assim o node falha com
    # "heap out of memory", que é legível, em vez de o cgroup matar o processo.
    NODE_OPTIONS=--max-old-space-size=2560

# Fixa a versão exigida pelo packageManager do repo, para a imagem não depender do
# que estiver no host. (O host do DEV1 resolve 11.5.2 corretamente num shell
# interativo; o que erra é a invocação não-interativa -- ver scripts/dev-env.sh e a
# seção 1 do plano. Aqui a razão é outra: uma imagem reproduzível não pergunta ao
# host qual pnpm usar.)
RUN corepack enable && corepack prepare pnpm@11.5.2 --activate

# git: parte do grafo resolve por git. curl: healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

EXPOSE 3000
CMD ["pnpm", "dev"]
